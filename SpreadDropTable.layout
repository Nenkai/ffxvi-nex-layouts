use_base_row_id|false

// Key2 is difficulty. Refer to difficultylevel for ids.

// This is a table defining item drops with weighted chances.

// Essentially:
// var numRolls = RandomRange(MinRollCount, MaxRollCount + 1);
// for (int i = 0; i < numRolls; i++)
// {
//     pick random index based on Item1/2/3DropPercentChance
//     index is item, Item1/2/3Union & count
//     variance is how many extra items to randomly remove OR add on top of count
// }

