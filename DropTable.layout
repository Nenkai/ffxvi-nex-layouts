table_name|DropTable
set_table_type|DoubleKeyed
set_table_category|DoubleKeyed
use_base_row_id|false

add_column|DLCFlags|int
add_column|Gil|int
add_column|Exp|int

// 0 = None
// 1 = Individual Roll, each item is picked if an individual roll for each chance passes
// 2 = Weighted Roll, one item is picked based on the sum of all chances and then RNG
add_column|DropType|int          // ref: 41 8B 48 ? 83 E9 ? 0F 84 ? ? ? ? 83 F9 ? 0F 85 ? ? ? ? 45 8B F3

add_column|ItemCount1|int
add_column|ItemCount2|int
add_column|ItemCount3|int
add_column|ItemCount4|int
add_column|ItemCount5|int
add_column|ItemCount6|int

// 124 = id from Item table
add_column|RewardUnion1|union
add_column|RewardUnion2|union
add_column|RewardUnion3|union
add_column|RewardUnion4|union
add_column|RewardUnion5|union
add_column|RewardUnion6|union

add_column|Chance1|byte
add_column|Chance2|byte
add_column|Chance3|byte
add_column|Chance4|byte
add_column|Chance5|byte
add_column|Chance6|byte
<implciit 2 bytes padding>
